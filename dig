#!/usr/bin/env bash
set -euo pipefail

# dynamically locate the real dig binary in the system path, 
# explicitly excluding this mock script to prevent infinite recursion.
real_dig=$(which -a dig | grep -vFx "$0" | head -n 1 || true)

if [[ -z "$real_dig" ]]; then
    echo "[-] dig mock error: real dig binary not found in system PATH." >&2
    exit 1
fi

# intercept mock domain for unit testing (dns failure lab)
if [[ "$*" == *"brokendomain.local"* ]]; then
    if [[ "$*" == *TXT* && "$*" != *"_dmarc"* ]]; then
        # simulate rfc violation: multiple spf records
        echo '"v=spf1 include:_spf.google.com ~all"'
        echo '"v=spf1 include:sendgrid.net -all"'
        exit 0
    fi
    
    if [[ "$*" == *"_dmarc.brokendomain.local"* ]]; then
        # simulate missing dmarc record
        exit 0
    fi
fi

# fallback to actual dig binary for all other external queries.
# use exec to replace the current process (saves memory overhead).
exec "$real_dig" "$@"